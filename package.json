{
  "name": "vmux-windows",
  "private": true,
  "version": "0.7.7",
  "description": "vMux — multi-agent AI orchestrator for Windows. Splits, localhost preview, event detection.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Vural Kutun",
    "email": "xlazvek@gmail.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win --x64 --publish never",
    "package:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "electron-vite build && electron-builder --win --x64 --publish always",
    "release:gh": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:GH_TOKEN = (gh auth token); if (-not $env:GH_TOKEN) { Write-Error 'gh auth token returned empty — run gh auth login'; exit 1 }; & npm.cmd run release\"",
    "release:all": "electron-vite build && electron-builder -mwl --publish always",
    "icon": "powershell -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "fetch-tools": "powershell -ExecutionPolicy Bypass -File scripts/fetch-search-tools.ps1",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "rebuild": "electron-builder install-app-deps",
    "lint": "npm run typecheck",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "set ANALYZE=1 && electron-vite build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-conf": "^1.3.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "pidtree": "^0.6.0",
    "pidusage": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lucide-react": "^1.14.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "node-gyp": "^12.3.0"
  },
  "build": {
    "appId": "com.vmux.app",
    "productName": "vMux",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/bin-win",
        "to": "bin",
        "filter": ["**/*.exe"]
      }
    ],
    "win": {
      "extraFiles": [
        {
          "from": "build/vmux.cmd",
          "to": "vmux.cmd"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.png"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "synopsis": "AI multi-agent terminal orchestrator",
      "description": "vMux runs multiple AI coding agents (Claude Code, Codex, Aider, Cursor CLI, Gemini) side by side in tmux-style splits, each in its own git worktree.",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "vMux",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vk1356",
        "repo": "vmux",
        "releaseType": "release"
      }
    ]
  }
}
